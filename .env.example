# EvidenceGraph Environment Configuration (Example)
# Fictional / Synthetic Development Setup

# Node / Web
VITE_API_URL=http://localhost:5000/api/v1
VITE_ANALYSIS_SERVICE_URL=http://localhost:8000

# PostgreSQL (Authoritative Store)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=evidencegraph
POSTGRES_USER=evidencegraph_app
POSTGRES_PASSWORD=evidencegraph_dev_secret_pw!
DATABASE_URL=Host=localhost;Port=5432;Database=evidencegraph;Username=evidencegraph_app;Password=evidencegraph_dev_secret_pw!

# Neo4j (Derived Analytical Knowledge Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password_2026!
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# MinIO (Write-Once Object Storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_pw!
MINIO_ORIGINAL_BUCKET=evidence-original
MINIO_DERIVED_BUCKET=evidence-derived

# ASP.NET Core API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000
JWT_SIGNING_KEY=EvidenceGraph_SuperSecure_JwtSecretKey_DevelopmentOnly_2026!_Min32Chars
JWT_ISSUER=EvidenceGraph.Api
JWT_AUDIENCE=EvidenceGraph.Web
JWT_EXPIRY_MINUTES=120

# Python Analysis Service
ANALYSIS_SERVICE_PORT=8000
AI_PROVIDER=mock
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Security / Hostile File Inspection
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
ENABLE_MALWARE_SCAN=false
MAX_UPLOAD_BYTES=104857600
